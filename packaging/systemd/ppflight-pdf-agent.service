[Unit]
Description=PPFlight PDF Agent
Documentation=file:/opt/ppflight-pdf-agent/current/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ppflight-pdf
Group=ppflight-pdf
WorkingDirectory=/opt/ppflight-pdf-agent/current
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/opt/ppflight-pdf-agent/current/.venv/bin/python /opt/ppflight-pdf-agent/current/scripts/verify-runtime-config.py /etc/ppflight-pdf-agent/config.json @ARTIFACT_DIR@
ExecStart=/opt/ppflight-pdf-agent/current/.venv/bin/python /opt/ppflight-pdf-agent/current/agent.py --config /etc/ppflight-pdf-agent/config.json run
Restart=on-failure
RestartSec=3
TimeoutStartSec=45
TimeoutStopSec=30
UMask=0077
Nice=10
CPUWeight=25
CPUQuota=150%
IOWeight=25
MemoryHigh=1536M
MemoryMax=2G
MemorySwapMax=512M
TasksMax=128

# The core hard-codes its listener to 127.0.0.1; its configuration is verified
# before startup to keep port 9760 and the private artifact/state paths fixed.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Do not enable MemoryDenyWriteExecute here. Supported PHP builds and their
# fixed rendering extensions require executable runtime mappings; enabling it
# makes the Python-to-PHP renderer fail inside this otherwise valid sandbox.
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/ppflight-pdf-agent @ARTIFACT_DIR@

[Install]
WantedBy=multi-user.target
