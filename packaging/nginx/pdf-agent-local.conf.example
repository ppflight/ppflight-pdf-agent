# This loopback filtering proxy has no static file root. Point Cloudflare
# Tunnel at 127.0.0.1:9761; the Agent itself remains on 127.0.0.1:9760.
server {
    listen 127.0.0.1:9761;
    server_name _;

    access_log off;
    # Upstream failures can include the complete grant-bearing request URI.
    # Cloudflare supplies edge observability; do not persist capability URLs.
    error_log /dev/null crit;

    # Only the signed customer download route may cross the public tunnel.
    # In particular, the Agent's local /healthz is never proxied publicly.
    location ~ "^/v1/download/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" {
        proxy_pass http://127.0.0.1:9760;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    location / { return 404; }
}
