# Direct-DNS publication example. This file is included from Nginx's http
# context. Point pdf-worker.ppflight.com at this VPS,
# provision a valid certificate, and expose only TCP 443. Never expose the
# Agent's loopback ports 9760/9761 or use the artifact directory as a web root.
limit_req_zone $binary_remote_addr zone=ppflight_pdf_rate:1m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=ppflight_pdf_conn:1m;

server {
    # The listen-parameter form works with Debian 12's Nginx 1.22.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name pdf-worker.ppflight.com;

    ssl_certificate /etc/letsencrypt/live/pdf-worker.ppflight.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pdf-worker.ppflight.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Signed grants are query parameters. Do not record them in access logs.
    access_log off;
    # Nginx upstream errors include the full request URI, including the bearer
    # grant query parameter. Discard this vhost's request error log as well.
    error_log /dev/null crit;
    server_tokens off;
    client_max_body_size 1k;
    client_header_timeout 10s;
    client_body_timeout 10s;
    keepalive_timeout 15s;
    send_timeout 30s;

    # Only the signed customer download route is public. /healthz and every
    # control/runtime path remain local-only.
    location ~ "^/v1/download/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" {
        limit_except GET HEAD { deny all; }
        limit_req zone=ppflight_pdf_rate burst=20 nodelay;
        limit_conn ppflight_pdf_conn 10;

        proxy_pass http://127.0.0.1:9760;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    location / { return 404; }
}
